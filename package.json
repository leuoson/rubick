{
  "name": "rubick",
  "version": "4.3.7",
  "author": "muwoo <2424880409@qq.com>",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "lint": "eslint .",
    "feature:dev": "cd feature & npm run serve",
    "release": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps"
  },
  "main": "out/main/index.js",
  "optionalDependencies": {
    "electron-clipboard-ex": "^1.3.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.54",
    "@ai-sdk/google": "^2.0.45",
    "@ai-sdk/openai": "^2.0.80",
    "@ai-sdk/openai-compatible": "^1.0.28",
    "@better-scroll/core": "^2.4.2",
    "@electron/remote": "^2.1.3",
    "ai": "^5.0.110",
    "ant-design-vue": "3.2.14",
    "axios": "^1.3.4",
    "core-js": "^3.6.5",
    "cross-spawn": "^7.0.3",
    "electron-updater": "^4.6.5",
    "extract-file-icon": "^0.3.2",
    "fix-path": "^3.0.0",
    "fs-extra": "^11.3.2",
    "get-mac-apps": "^1.0.2",
    "got": "^11.8.3",
    "lodash.debounce": "^4.0.8",
    "memorystream": "^0.3.1",
    "node-key-sender": "^1.0.11",
    "pinyin-match": "^1.2.4",
    "pouchdb": "^7.2.2",
    "pouchdb-load": "^1.4.6",
    "pouchdb-replication-stream": "^1.2.9",
    "simple-plist": "0.2.1",
    "uiohook-napi": "^1.5.4",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0-0",
    "vuex": "^4.0.0-0",
    "webdav": "4.11.3",
    "worker-loader": "^3.0.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electron/asar": "^3.2.8",
    "@ts-type/package-dts": "^1.0.53",
    "@types/electron-devtools-installer": "^2.2.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/compiler-sfc": "^3.4.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "compressing": "^1.10.0",
    "electron": "39.2.6",
    "electron-builder": "^25.1.0",
    "electron-devtools-installer": "^3.1.0",
    "electron-vite": "^2.3.0",
    "eslint": "^8.56.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-vue": "^9.19.0",
    "less": "^3.0.4",
    "less-loader": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.6"
  },
  "resolutions": {
    "leveldown": "6.0.3"
  },
  "build": {
    "productName": "rubick",
    "appId": "com.muwoo.rubick",
    "compression": "maximum",
    "directories": {
      "output": "build"
    },
    "releaseInfo": {
      "releaseName": "normal",
      "releaseNotesFile": "./release/releaseNotes.md"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rubickCenter",
        "repo": "rubick"
      }
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "public/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "rubick-${version}-${arch}.dmg",
      "gatekeeperAssess": false,
      "entitlementsInherit": "./release/entitlements.mac.plist",
      "entitlements": "./release/entitlements.mac.plist",
      "hardenedRuntime": true,
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "LSUIElement": 1
      }
    },
    "win": {
      "icon": "public/icons/icon.ico",
      "artifactName": "rubick-Setup-${version}-${arch}.exe",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "shortcutName": "rubick",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "public/installer.nsh"
    },
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/extract-file-icon/**",
      "**/node_modules/uiohook-napi/**",
      "**/node_modules/node-key-sender/**",
      "**/node_modules/electron-clipboard-ex/**"
    ],
    "linux": {
      "icon": "public/icons/",
      "publish": [
        "github"
      ],
      "target": "deb"
    },
    "extraResources": [
      {
        "from": "public",
        "to": "static"
      }
    ]
  }
}
